# Kubernetes Secrets Template
# 
# IMPORTANT: This is a template file. DO NOT commit actual secrets to git!
# 
# To create secrets:
# 1. Copy this file to secrets.yaml (which should be in .gitignore)
# 2. Replace all placeholder values with base64-encoded actual values
# 3. Apply with: kubectl apply -f k8s/secrets.yaml
#
# To base64 encode a value:
# echo -n "your-value-here" | base64
#
# To decode a base64 value:
# echo "base64-value" | base64 -d

apiVersion: v1
kind: Secret
metadata:
  name: mailfind-secrets
  namespace: mailfind
type: Opaque
data:
  # Supabase Configuration (base64 encoded)
  # Example: echo -n "https://your-project.supabase.co" | base64
  SUPABASE_PUBLIC_URL: <base64-encoded-supabase-url>
  SERVICE_ROLE: <base64-encoded-service-role-key>
  SUPABASE_ANON_KEY: <base64-encoded-anon-key>
  
  # Google OAuth Configuration (base64 encoded)
  GOOGLE_CLIENT_ID: <base64-encoded-google-client-id>
  GOOGLE_CLIENT_SECRET: <base64-encoded-google-client-secret>
  
  # OpenAI Configuration (base64 encoded)
  OPENAI_API_KEY: <base64-encoded-openai-api-key>
  
  # Encryption Configuration (base64 encoded)
  # Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
  ENCRYPTION_KEY: <base64-encoded-encryption-key>

---
# Example of creating secrets imperatively (recommended for production):
#
# kubectl create secret generic mailfind-secrets \
#   --namespace=mailfind \
#   --from-literal=SUPABASE_PUBLIC_URL='https://your-project.supabase.co' \
#   --from-literal=SERVICE_ROLE='your-service-role-key' \
#   --from-literal=SUPABASE_ANON_KEY='your-anon-key' \
#   --from-literal=GOOGLE_CLIENT_ID='your-client-id' \
#   --from-literal=GOOGLE_CLIENT_SECRET='your-client-secret' \
#   --from-literal=OPENAI_API_KEY='sk-your-key' \
#   --from-literal=ENCRYPTION_KEY='your-fernet-key'

